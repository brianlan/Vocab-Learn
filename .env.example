# Copy to .env; keep real secrets out of Git. Generate a random Django key.
DJANGO_SECRET_KEY=
LAN_BIND_IP=127.0.0.1
APP_HOSTNAME=vocab.home.arpa
APP_ORIGIN=https://vocab.home.arpa
HTTPS_PORT=443
DISPLAY_TIMEZONE=Asia/Shanghai

# Environment values override .env. The default key is used only for the MiniMax origin.
MINIMAX_API_KEY=
ASR_PROTOCOL=minimax
ASR_ENDPOINT=https://api.minimax.cn/v1/speech_to_text
ASR_MODEL=asr-1.0
ASR_API_KEY=
ASR_TIMEOUT_SECONDS=60
JUDGE_ENDPOINT=https://api.minimax.cn/v1/chat/completions
JUDGE_MODEL=MiniMax-M3.1-Flash
JUDGE_API_KEY=
JUDGE_TIMEOUT_SECONDS=120
JUDGE_MAX_COMPLETION_TOKENS=8192
GENERATOR_ENDPOINT=https://api.minimax.cn/v1/chat/completions
GENERATOR_MODEL=MiniMax-M3.1-Flash
GENERATOR_API_KEY=
GENERATOR_TIMEOUT_SECONDS=120
GENERATOR_MAX_COMPLETION_TOKENS=8192
ASSESSMENT_TIMEOUT_SECONDS=300
GENERATION_TIMEOUT_SECONDS=300
WORKER_CLEANUP_GRACE_SECONDS=10
WORKER_CONCURRENCY=2
