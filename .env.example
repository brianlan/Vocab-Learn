# Copy to .env; keep real secrets out of Git. Generate a random Django key.
DJANGO_SECRET_KEY=
LAN_BIND_IP=127.0.0.1
APP_HOSTNAME=vocab.home.arpa
APP_ORIGIN=https://vocab.home.arpa
HTTPS_PORT=443
# Optional second private interface; enable both lines together.
# COMPOSE_FILE=compose.yaml:compose.secondary-ip.yaml
# SECONDARY_LAN_BIND_IP=10.243.80.19
DISPLAY_TIMEZONE=Asia/Shanghai

# Environment values override .env. The default key is used only for the MiniMax origin.
MINIMAX_API_KEY=
# Spoken assessment: one audio-capable model request returns validated judgments and feedback, without a transcript.
# AUDIO_ASSESS_PROVIDER selects the request dialect: qwen (default Qwen3.8-Omni-Flash) or doubao
# (Doubao Seed 2.1 Lite over regular inference), or stepfun (StepAudio 3 Chat Preview).
# stepfun supports chat_completions only and uses the evaluated provider-default reasoning.
# For StepAudio, set AUDIO_ASSESS_PROVIDER=stepfun and put its key in AUDIO_ASSESS_API_KEY.
# AUDIO_ASSESS_API_MODE selects the request family:
# chat_completions (default) or responses; invalid values fail startup. An empty endpoint resolves
# to the provider+mode default; an explicit AUDIO_ASSESS_ENDPOINT is never rewritten, so update it
# (for example an old /responses URL) when switching modes. Endpoint/model below override
# the provider defaults.
AUDIO_ASSESS_PROVIDER=qwen
AUDIO_ASSESS_API_MODE=chat_completions
AUDIO_ASSESS_ENDPOINT=
AUDIO_ASSESS_MODEL=
AUDIO_ASSESS_API_KEY=
AUDIO_ASSESS_TIMEOUT_SECONDS=60
AUDIO_ASSESS_MAX_COMPLETION_TOKENS=8192
# Generation prepares examples; the example reviewer accepts, repairs or replaces the pair in one call.
# GLM requires an explicit task key; the MiniMax key fallback stays restricted to the MiniMax origin.
GENERATOR_ENDPOINT=https://open.bigmodel.cn/api/coding/paas/v4/chat/completions
GENERATOR_MODEL=glm-5.3-flash
GENERATOR_PROTOCOL=zhipu
GENERATOR_API_KEY=
GENERATOR_THINKING=enabled
GENERATOR_REASONING_EFFORT=max
GENERATOR_TIMEOUT_SECONDS=120
GENERATOR_MAX_COMPLETION_TOKENS=8192
EXAMPLE_REVIEWER_ENDPOINT=https://api.minimax.cn/v1/chat/completions
EXAMPLE_REVIEWER_MODEL=MiniMax-M3.1-Flash
EXAMPLE_REVIEWER_PROTOCOL=minimax
EXAMPLE_REVIEWER_API_KEY=
EXAMPLE_REVIEWER_THINKING=adaptive
EXAMPLE_REVIEWER_REASONING_EFFORT=max
EXAMPLE_REVIEWER_TIMEOUT_SECONDS=120
EXAMPLE_REVIEWER_MAX_COMPLETION_TOKENS=8192
DEFINITION_ENDPOINT=https://api.minimax.cn/v1/chat/completions
DEFINITION_MODEL=MiniMax-M3.1-Flash
DEFINITION_API_KEY=
DEFINITION_TIMEOUT_SECONDS=120
DEFINITION_MAX_COMPLETION_TOKENS=8192
# Sentence speech: one synchronous MiniMax request per example side, stored under /data/tts in the
# app data volume (covered by the cold backup). SPEECH_API_KEY falls back to MINIMAX_API_KEY at the
# MiniMax origin. Per-language voices apply to later dispatches, including explicit retries; the
# Spain Spanish voice stays a candidate until the documented listening check passes.
SPEECH_ENDPOINT=https://api.minimax.cn/v1/t2a_v2
# An unset or empty model resolves to speech-2.8-turbo; a nonempty override applies to later dispatches.
SPEECH_MODEL=
SPEECH_API_KEY=
SPEECH_TIMEOUT_SECONDS=120
SPEECH_VOICE_ENGLISH=
SPEECH_VOICE_SPANISH=
SPEECH_VOICE_MANDARIN=
# Assessment is bounded to the 15-second budget measured from Stop & check; the execution deadline is the
# request anchor (recorded before body-consuming middleware) plus the total budget, so transfer, staging
# and database lock waiting each count against that absolute deadline exactly once. Generation execution
# starts at worker claim and is shared by optional vocabulary completion, generation and the example review.
ASSESSMENT_TIMEOUT_SECONDS=15
GENERATION_TIMEOUT_SECONDS=420
WORKER_CLEANUP_GRACE_SECONDS=10
WORKER_CONCURRENCY=2
